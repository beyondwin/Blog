---
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';
import '../styles/press.css';

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
  themeColor?: string;
  canonicalPath?: string;
  designContract?: string;
}

const {
  title = 'beyondwin',
  description = '글과 책, 그리고 남는 문장.',
  pageClass = 'press-page',
  themeColor = '#878680',
  canonicalPath = Astro.url.pathname,
  designContract,
} = Astro.props;

const bodyDesignComment = designContract
  ? `<!--\n${designContract}\n-->`
  : '<!-- The route supplies its public product surface inside this shared site shell. -->';
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <link rel="canonical" href={canonicalPath} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class={pageClass}>
    <Fragment set:html={bodyDesignComment} />
    <SiteHeader>
      <slot name="header-mark" />
    </SiteHeader>
    <main class="site-main">
      <slot />
    </main>
  </body>
</html>
