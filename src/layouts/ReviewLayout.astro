---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import SiteFooter from '../components/SiteFooter.astro';
import BaseLayout from './BaseLayout.astro';
import { formatReadMonth } from '../lib/bookshelfPresentation';
import type { RecordDetail } from '../lib/content/viewModels';

type ReviewEntry = CollectionEntry<'reviews'>;

interface RelatedBook {
  entry: ReviewEntry;
  relationshipReason: string;
}

interface Props {
  entry: ReviewEntry;
  detail: RecordDetail;
  relatedBooks?: RelatedBook[];
}

const { entry, detail, relatedBooks = [] } = Astro.props;
const date = entry.data.completedAt ?? detail.primaryDate;
const judgment = detail.verdict ?? detail.description;
const authorLine = detail.authors.join(' · ');
const whisper = [detail.publisher, detail.editionLabel].filter(Boolean).join(' · ');
const title = entry.data.itemTitle;
---

<BaseLayout title={`${title} · beyondwin`} description={judgment}>
  <article class="press-sheet book-sheet">
    <aside class="book-object" aria-label="책">
      {detail.media ? (
        <figure class="book-object__cover">
          <Image
            class="book-cover"
            src={detail.media.asset}
            alt={detail.media.item.alt}
            loading="eager"
            decoding="async"
          />
        </figure>
      ) : (
        <div class="book-object__cover">
          <span class="book-cover book-cover--set">
            <b>{title}</b>
            {authorLine && <em>{authorLine}</em>}
          </span>
        </div>
      )}

      {whisper && <p class="book-object__whisper">{whisper}</p>}
    </aside>

    {detail.media ? (
      <Image
        class="book-cover book-cover--remnant"
        src={detail.media.asset}
        alt=""
        loading="lazy"
        data-book-remnant
      />
    ) : (
      <span class="book-cover book-cover--remnant book-cover--set" aria-hidden="true" data-book-remnant>
        <b>{title}</b>
      </span>
    )}

    <div class="book-reading">
      <header>
        <h1 class="book-title">{title}</h1>
        {authorLine && <p class="book-author">{authorLine}</p>}
        <p class="book-verdict">{judgment}</p>
        <time datetime={date.toISOString()}>{formatReadMonth(date)}</time>
      </header>

      <div class="prose book-prose">
        <slot />
      </div>
    </div>

    {relatedBooks.length > 0 && (
      <aside class="book-related">
        {relatedBooks.slice(0, 3).map(({ entry: related, relationshipReason }) => (
          <a href={`/reviews/${related.id}/`}>
            <strong>{related.data.itemTitle}</strong>
            <span>{relationshipReason}</span>
          </a>
        ))}
      </aside>
    )}
  </article>
  <SiteFooter />
</BaseLayout>

<script>
  const cover = document.querySelector('.book-object__cover');
  const remnant = document.querySelector<HTMLElement>('[data-book-remnant]');
  if (cover && remnant && 'IntersectionObserver' in window) {
    const sync = (visible: boolean) => {
      remnant.classList.toggle('is-visible', !visible);
    };
    const observer = new IntersectionObserver(([entry]) => {
      sync(entry.isIntersecting);
    }, { threshold: 0.2 });
    observer.observe(cover);
    sync(true);
  }
</script>
