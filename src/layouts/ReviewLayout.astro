---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import {
  formatLiteraryDate,
  getOneSentenceJudgment,
} from '../lib/bookshelfPresentation';
import '../styles/bookshelf-literary.css';
import type { RecordDetail } from '../lib/content/viewModels';

type ReviewEntry = CollectionEntry<'reviews'>;

interface RelatedBook {
  entry: ReviewEntry;
  relationshipReason: string;
}

interface Props {
  entry: ReviewEntry;
  detail: RecordDetail;
  relatedBooks?: RelatedBook[];
}

const { entry, detail, relatedBooks = [] } = Astro.props;
const date = detail.primaryDate;
const judgment = getOneSentenceJudgment(detail.verdict ?? detail.description);
const authorLine = detail.authors.join(' · ');
---

<BaseLayout
  title={`${entry.data.title} · beyondwin`}
  description={judgment}
  pageClass="literary-page literary-review"
  headerVariant="literary"
>
  <article class="shell review-literary">
    <aside class="review-literary__book" aria-label="책 정보">
      {detail.media ? (
        <figure>
          <Image
            src={detail.media.asset}
            alt={detail.media.item.alt}
            loading="eager"
            decoding="async"
          />
        </figure>
      ) : (
        <div class="review-literary__cover-fallback" aria-label="표지 확인 중">
          <span>{detail.title}</span>
          <b>표지 확인 중</b>
        </div>
      )}

      <dl>
        {detail.authors.length > 0 && <><dt>저자</dt><dd>{authorLine}</dd></>}
        <div class="review-literary__completed">
          <dt>완독</dt>
          <dd><time datetime={date.toISOString()}>{formatLiteraryDate(date)}</time></dd>
        </div>
      </dl>
    </aside>

    <div class="review-literary__reading">
      <header>
        <h1>{detail.title}</h1>
        {detail.authors.length > 0 && <p>{authorLine}</p>}
        <time class="review-literary__mobile-date" datetime={date.toISOString()}>{formatLiteraryDate(date)}</time>
        <span class="literary-registration" aria-hidden="true"></span>
        <blockquote>{judgment}</blockquote>
      </header>

      <div class="review-literary__prose prose">
        <slot />
      </div>
    </div>

    {relatedBooks.length > 0 && (
      <aside class="review-literary__related" aria-labelledby="related-books-title">
        <h2 id="related-books-title">함께 읽으면 좋은 책</h2>
        <ol>
          {relatedBooks.slice(0, 3).map(({ entry: related, relationshipReason }) => (
            <li>
              <a href={`/reviews/${related.id}/`}>
                <strong>{related.data.itemTitle}</strong>
                <span>{relationshipReason}</span>
              </a>
            </li>
          ))}
        </ol>
      </aside>
    )}
  </article>

  <footer class="shell literary-footer">
    <span>© beyondwin</span>
    <p>이 사이트는 한 사람의 느린 기록으로 만들어집니다.</p>
    <nav aria-label="보조 메뉴"><a href="/reviews/">책장</a><a href="/tags/">색인</a></nav>
  </footer>
</BaseLayout>
