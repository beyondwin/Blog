---
import SiteFooter from '../components/SiteFooter.astro';
import BaseLayout from './BaseLayout.astro';
import {
  articleJudgment,
  articleSpecies,
  parseColophon,
  type ArticleImpression,
  type LeftoverSentence,
  type RecordsArticle,
} from '../lib/recordsPresentation';
import type { SiteEntry } from '../lib/content';

interface TocItem {
  depth: number;
  href: string;
  label: string;
}

interface Props {
  entry: SiteEntry;
  headings?: TocItem[];
  readingMinutes?: number;
  previousImpressions?: ArticleImpression[];
  leftoverSentence?: LeftoverSentence;
  colophon?: string;
}

const {
  entry,
  headings = [],
  readingMinutes,
  previousImpressions = [],
  leftoverSentence: leftover,
  colophon,
} = Astro.props;

const article = entry.collection === 'articles' ? entry as RecordsArticle : undefined;
const species = article ? articleSpecies(article) : undefined;
const judgment = article ? articleJudgment(article) : entry.data.description;
const kicker = species === '조사' && readingMinutes
  ? `조사 · ${readingMinutes}분`
  : species;
const toc = headings.filter((heading) => heading.depth === 2 && heading.label !== '확인한 자료');
const colophonBlocks = colophon ? parseColophon(colophon) : [];
---

<BaseLayout title={`${entry.data.title} · beyondwin`} description={entry.data.description}>
  <article class="press-sheet article-sheet">
    <header class="article-masthead">
      {kicker && <p class="article-kicker">{kicker}</p>}
      <h1>{entry.data.title}</h1>
      {judgment && <p class="article-judgment">{judgment}</p>}
      {previousImpressions.length > 0 && (
        <nav class="article-impression" aria-label="쇄">
          <span aria-current="page">이 쇄</span>
          {previousImpressions.map((item) => (
            <a href={item.href}>이전 쇄</a>
          ))}
        </nav>
      )}
    </header>

    <div class="article-read">
      {species === '조사' && toc.length > 0 && (
        <nav class="article-toc" aria-label="절">
          <ol>
            {toc.map((heading) => (
              <li><a href={heading.href}>{heading.label}</a></li>
            ))}
          </ol>
        </nav>
      )}
      <div class="prose article-prose"><slot /></div>
    </div>

    {leftover && (
      <aside class="article-leftover">
        <p>남은 문장</p>
        <a href={leftover.href}>{leftover.claim}</a>
      </aside>
    )}

    {colophonBlocks.length > 0 && (
      <section class="article-colophon">
        <h2>확인한 자료</h2>
        {colophonBlocks.map((block) => (
          block.type === 'ul' ? (
            <ul>
              {block.items.map((item) => (
                <li>
                  {item.href ? <a href={item.href}>{item.label}</a> : item.label}
                </li>
              ))}
            </ul>
          ) : (
            <p>{block.text}</p>
          )
        ))}
      </section>
    )}
  </article>
  <SiteFooter />
</BaseLayout>

<script>
  const source = document.querySelector<HTMLElement>('.article-prose h2#확인한-자료');
  const dest = document.querySelector<HTMLElement>('.article-colophon h2');
  if (source) {
    let node: Element | null = source;
    while (node) {
      const next: Element | null = node.nextElementSibling;
      node.setAttribute('hidden', '');
      node = next;
    }
    if (dest) {
      source.removeAttribute('id');
      dest.id = '확인한-자료';
    }
  }
</script>
