---
import type { CollectionEntry } from 'astro:content';
import SiteFooter from '../components/SiteFooter.astro';
import BaseLayout from './BaseLayout.astro';

interface Props {
  entry: CollectionEntry<'analysis'>;
}

const { entry } = Astro.props;
---

<BaseLayout title={`${entry.data.title} · beyondwin`} description={entry.data.description}>
  <article class="press-sheet article-sheet">
    <header class="article-masthead">
      <h1>{entry.data.title}</h1>
      {entry.data.description && <p class="article-judgment">{entry.data.description}</p>}
    </header>
    <div class="article-read">
      <div class="prose article-prose">
        <slot />
      </div>
    </div>
    {entry.data.sourceTitle && entry.data.sourceUrl && (
      <section class="article-colophon">
        <h2>확인한 자료</h2>
        <p><a href={entry.data.sourceUrl}>{entry.data.sourceTitle}</a></p>
      </section>
    )}
  </article>
  <SiteFooter />
</BaseLayout>
