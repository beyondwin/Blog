---
import { Image } from 'astro:assets';
import type { RecordSummary } from '../lib/content/viewModels';

interface Props {
  entry: RecordSummary;
  tall?: boolean;
}

const { entry, tall = false } = Astro.props;
---

{entry.media ? (
  <Image
    class:list={['lead-cover', { 'lead-cover--tall': tall }]}
    src={entry.media.asset}
    alt={entry.media.item.alt}
    width={tall ? 240 : 220}
    height={tall ? 336 : 308}
    loading="eager"
  />
) : (
  <span
    class:list={['lead-cover', 'lead-cover-placeholder', { 'lead-cover--tall': tall }]}
    role="img"
    aria-label={`${entry.title} 표지 확인 중`}
  >
    <span>{entry.title}</span>
    <b>표지 확인 중</b>
  </span>
)}
