---
import { Image } from 'astro:assets';
import { resolveFigureContext } from '../lib/content/figureContext';
import { buildFigurePresentation } from '../lib/content/figurePresentation';
import { resolveContentMedia } from '../lib/content/mediaRegistry';

interface Props {
  media: string;
  collection?: 'articles';
  slug?: string;
}

const { media, collection, slug } = Astro.props;
const routeContext = collection && slug
  ? { collection, slug }
  : resolveFigureContext(Astro.url.pathname);
const resolved = resolveContentMedia(routeContext.collection, routeContext.slug, media);
const presentation = buildFigurePresentation(resolved.item);
---

<figure class="content-figure">
  <Image
    src={resolved.asset}
    alt={resolved.item.alt}
    widths={[720, 1080, 1600]}
    sizes="(max-width: 760px) calc(100vw - 40px), min(42em, 100vw - 80px)"
    loading="lazy"
    decoding="async"
  />
  <figcaption>
    <span>{presentation.caption}</span>
    {presentation.provenanceHref && (
      <small>
        {presentation.credit} · <a href={presentation.provenanceHref} rel="noreferrer">{presentation.provenanceLabel}</a>
      </small>
    )}
  </figcaption>
</figure>

<style>
  .content-figure { margin: 2.6rem 0; }
  .content-figure :global(img) { display: block; height: auto; width: 100%; }
  .content-figure figcaption { border-top: 1px solid var(--mark, #8a8880); display: grid; gap: 0.25rem; margin-top: 0.75rem; padding-top: 0.65rem; }
  .content-figure figcaption span { color: var(--ink, #171717); font-size: 0.82rem; line-height: 1.5; }
  .content-figure figcaption small { color: var(--soft, #686868); font-size: 0.7rem; line-height: 1.5; overflow-wrap: anywhere; }
  .content-figure figcaption a { color: inherit; text-underline-offset: 0.18em; }
</style>
