---
import SiteFooter from '../../components/SiteFooter.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllContent } from '../../lib/content';
import { buildTagIndex } from '../../lib/indexPresentation';

const entries = await getAllContent();
const contentTags = buildTagIndex(entries.map((entry) => entry.data.tags));
---

<BaseLayout title="beyondwin" description="찾기로 이어진 단어들.">
  <div class="press-sheet tag-index">
    <p class="tag-index__lead">찾기로 이어진 단어들입니다.</p>
    {contentTags.length > 0 && (
      <ul class="tag-index__words">
        {contentTags.map((tag) => (
          <li><a href={`/tags/${encodeURIComponent(tag.label)}/`}>{tag.label}</a></li>
        ))}
      </ul>
    )}
    <p class="tag-index__sentences"><a href="/memory/">남는 문장</a></p>
  </div>
  <SiteFooter />
</BaseLayout>
