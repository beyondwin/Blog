---
import SiteFooter from '../../components/SiteFooter.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllContent, getAllTags, getEntryHref } from '../../lib/content';

export async function getStaticPaths() {
  const tags = await getAllTags();
  return tags.map((tag) => ({ params: { tag }, props: { tag } }));
}

const { tag } = Astro.props;
const entries = (await getAllContent()).filter((entry) => entry.data.tags.includes(tag));
---

<BaseLayout title={`${tag} · beyondwin`} description={`${tag}로 이어진 글과 책.`}>
  <div class="press-sheet tag-sheet">
    <h1>{tag}</h1>
    {entries.length > 0 ? (
      <ol class="tag-sheet__list">
        {entries.map((entry) => (
          <li>
            <a href={getEntryHref(entry)}>
              <span class="tag-sheet__kind">{entry.collection === 'reviews' ? '책' : '글'}</span>
              <span class="tag-sheet__title">
                {entry.collection === 'reviews' ? entry.data.itemTitle : entry.data.title}
              </span>
            </a>
          </li>
        ))}
      </ol>
    ) : (
      <p>이 단어로 이어진 글이 없습니다.</p>
    )}
    <p class="tag-sheet__back"><a href="/search/">찾기</a></p>
  </div>
  <SiteFooter />
</BaseLayout>
