---
import LiteraryFooter from '../../components/LiteraryFooter.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getAllContent, getAllTags, getEntryDate, getEntryHref } from '../../lib/content';
import '../../styles/index-literary.css';

export async function getStaticPaths() {
  const tags = await getAllTags();
  return tags.map((tag) => ({ params: { tag }, props: { tag } }));
}

const { tag } = Astro.props;
const entries = (await getAllContent()).filter((entry) => entry.data.tags.includes(tag));
---

<BaseLayout title={`${tag} · beyondwin`} description={`${tag} 태그가 붙은 공개 기록.`} pageClass="literary-page literary-index literary-index--tag" headerVariant="literary">
  <div class="shell tag-sheet">
    <header class="tag-intro">
      <p>주제</p>
      <h1>{tag}</h1>
      <span class="literary-registration" aria-hidden="true"></span>
      <p>이 단어로 이어진 공개 기록 {entries.length}개</p>
      <a href="/tags/">전체 색인 <span>←</span></a>
    </header>
    <section class="tag-records" aria-label={`${tag} 기록`}>
      {entries.map((entry, index) => (
        <a href={getEntryHref(entry)}>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <div>
            <small>{entry.collection === 'reviews' ? '읽은 책' : '기술 문서'}</small>
            <h2>{entry.collection === 'reviews' ? entry.data.itemTitle : entry.data.title}</h2>
            <p>{entry.data.description}</p>
          </div>
          <time>{formatDate(getEntryDate(entry))}</time>
          <b aria-hidden="true">→</b>
        </a>
      ))}
    </section>
  </div>
  <LiteraryFooter />
</BaseLayout>
