---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { getCollection } from 'astro:content';
import { buildArticleIndex } from '../../lib/recordsPresentation';
import { isPublicEntry } from '../../lib/content/publication';

const entries = (await getCollection('articles', isPublicEntry)).sort((a, b) => (
  b.data.updatedAt.getTime() - a.data.updatedAt.getTime()
));
const { lead, entries: ledger } = buildArticleIndex(entries);
---

<BaseLayout title="글 · beyondwin" description="다 쓴 에세이와 조사.">
  <div class="press-sheet article-index">
    {lead ? (
      <a class="article-lead" href={lead.href}>
        <p class="article-kicker">
          {lead.species === '조사' ? `${lead.monthLabel} · 조사` : '에세이'}
        </p>
        <h1>{lead.title}</h1>
        <p>{lead.stake}</p>
      </a>
    ) : (
      <p>아직 공개한 글이 없습니다.</p>
    )}

    {ledger.length > 0 && (
      <ol class="article-ledger">
        {ledger.map((entry) => (
          <li>
            <a href={entry.href}>
              <span class="article-ledger__month">{entry.monthLabel}</span>
              <span class="article-ledger__copy">
                <span class="article-ledger__title">{entry.title}</span>
                <span class="article-ledger__stake">{entry.stake}</span>
              </span>
              <span class="article-ledger__kind">
                {entry.hasEvidence ? `${entry.species} · 근거` : entry.species}
              </span>
            </a>
          </li>
        ))}
      </ol>
    )}
  </div>
  <SiteFooter />
</BaseLayout>
