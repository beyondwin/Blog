---
import { getCollection, render } from 'astro:content';
import ArticleBriefTable from '../../components/ArticleBriefTable.astro';
import Callout from '../../components/Callout.astro';
import Figure from '../../components/Figure.astro';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { findContentMemoryLinks, loadPublicMemoryData } from '../../lib/memory';
import {
  articleColophon,
  buildArticlePresentation,
  leftoverSentence,
} from '../../lib/recordsPresentation';
import { isPublicEntry } from '../../lib/content/publication';

export async function getStaticPaths() {
  const entries = await getCollection('articles', isPublicEntry);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const articles = await getCollection('articles', isPublicEntry);
const presentation = buildArticlePresentation(entry, articles, headings);
const leftover = leftoverSentence(findContentMemoryLinks(
  loadPublicMemoryData(),
  `src/content/articles/${entry.id}.mdx`,
));
const table = presentation.species === '조사' ? ArticleBriefTable : undefined;
---

<ArticleLayout
  entry={entry}
  headings={presentation.toc}
  readingMinutes={presentation.readingMinutes}
  previousImpressions={presentation.previousImpressions}
  leftoverSentence={leftover}
  colophon={articleColophon(entry)}
>
  <Content components={{ Callout, Figure, ...(table ? { table } : {}) }} />
</ArticleLayout>
