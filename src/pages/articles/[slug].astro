---
import { getCollection, render } from 'astro:content';
import Callout from '../../components/Callout.astro';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { findContentMemoryLinks, loadPublicMemoryData } from '../../lib/memory';
import { buildArticlePresentation } from '../../lib/recordsPresentation';

export async function getStaticPaths() {
  const entries = await getCollection('articles', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const articles = await getCollection('articles', ({ data }) => !data.draft);
const presentation = buildArticlePresentation(entry, articles, headings);
const relatedMemory = findContentMemoryLinks(
  loadPublicMemoryData(),
  `src/content/articles/${entry.id}.mdx`,
  entry.data.tags,
);
---

<ArticleLayout
  entry={entry}
  headings={presentation.toc}
  readingMinutes={presentation.readingMinutes}
  relatedArticles={presentation.related}
  relatedMemory={relatedMemory}
>
  <Content components={{ Callout }} />
</ArticleLayout>
