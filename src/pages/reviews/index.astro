---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { isPublicEntry } from '../../lib/content/publication';
import {
  buildBookshelfPresentation,
  getOneSentenceJudgment,
} from '../../lib/bookshelfPresentation';

const entries = await getCollection('reviews', isPublicEntry);
const presentation = buildBookshelfPresentation(entries);
const objects = presentation.shelfTiers.flat();
const diary: Array<{ year: number; entries: typeof presentation.judgmentEntries }> = [];
for (const entry of presentation.judgmentEntries) {
  const year = entry.primaryDate.getFullYear();
  const current = diary.at(-1);
  if (!current || current.year !== year) {
    diary.push({ year, entries: [entry] });
  } else {
    current.entries.push(entry);
  }
}
---

<BaseLayout title="책 · beyondwin" description="읽고 남은 판단.">
  <div class="press-sheet book-index">
    <h1 class="visually-hidden">책</h1>

    {objects.length > 0 && (
      <ol class="book-objects">
        {objects.map((entry, index) => (
          <li>
            <a class="book-card" href={entry.href}>
              {entry.media ? (
                <Image
                  class="book-cover"
                  src={entry.media.asset}
                  alt={entry.media.item.alt}
                  loading={index < 4 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              ) : (
                <span class="book-cover book-cover--set">
                  <b>{entry.title}</b>
                  {entry.authors.length > 0 && <em>{entry.authors.join(' · ')}</em>}
                </span>
              )}
              <strong class="book-title">{entry.title}</strong>
              {entry.authors.length > 0 && (
                <em class="book-author">{entry.authors.join(' · ')}</em>
              )}
              <span class="book-verdict">{getOneSentenceJudgment(entry.verdict ?? entry.description)}</span>
            </a>
          </li>
        ))}
      </ol>
    )}

    {diary.map(({ year, entries: yearEntries }) => (
      <section class="book-diary" id={`reviews-${year}`}>
        <h2>{year}</h2>
        <ol>
          {yearEntries.map((entry) => (
            <li>
              <a href={entry.href}>
                {entry.media ? (
                  <Image
                    class="book-cover book-cover--small"
                    src={entry.media.asset}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="book-cover book-cover--small book-cover--set">
                    <b>{entry.title}</b>
                    {entry.authors.length > 0 && <em>{entry.authors.join(' · ')}</em>}
                  </span>
                )}
                <span class="book-diary__copy">
                  <strong class="book-title">{entry.title}</strong>
                  <span class="book-verdict">{getOneSentenceJudgment(entry.verdict ?? entry.description)}</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
  <SiteFooter />
</BaseLayout>
