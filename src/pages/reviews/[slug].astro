---
import { getCollection, render } from 'astro:content';
import Callout from '../../components/Callout.astro';
import ReviewLayout from '../../layouts/ReviewLayout.astro';
import { findRelatedBooks } from '../../lib/bookshelfPresentation';
import { isPublicEntry } from '../../lib/content/publication';
import { toRecordDetail } from '../../lib/content/viewModels';

export async function getStaticPaths() {
  const entries = await getCollection('reviews', isPublicEntry);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: {
      entry,
      relatedBooks: findRelatedBooks(entry, entries),
    },
  }));
}

const { entry, relatedBooks } = Astro.props;
const { Content } = await render(entry);
const detail = toRecordDetail(entry, { linked: [] });
---

<ReviewLayout entry={entry} detail={detail} relatedBooks={relatedBooks}>
  <Content components={{ Callout }} />
</ReviewLayout>
