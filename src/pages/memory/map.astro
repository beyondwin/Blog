---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LiteraryFooter from '../../components/LiteraryFooter.astro';
import { buildMemoryPagePayload, getLiteraryMemoryMapPosition, loadPublicMemoryData, prefixedThoughtId, sortLiteraryMemoryThoughts } from '../../lib/memory';
import '../../styles/memory-literary.css';

const memory = loadPublicMemoryData();
const thoughts = sortLiteraryMemoryThoughts(memory.thoughts);
const payload = buildMemoryPagePayload(memory);
const selected = thoughts.find((thought) => thought.slug === 'memory-needs-retrieval-not-decoration') ?? thoughts[0];
const selectedId = selected ? prefixedThoughtId(selected.slug) : null;
const directEdges = payload.graph.edges.filter((edge) => !edge.derived && edge.from.startsWith('thought:') && edge.to.startsWith('thought:'));
const graphNodesById = new Map(payload.graph.nodes.filter((node) => node.kind === 'thought').map((node) => [node.id, node]));
const thoughtNodes = thoughts
  .map((thought, index) => {
    const node = graphNodesById.get(prefixedThoughtId(thought.slug));
    return node ? { ...node, position: getLiteraryMemoryMapPosition(index) } : null;
  })
  .filter((node) => node !== null);
const positionsById = Object.fromEntries(thoughtNodes.map((node) => [node.id, node.position])) as Record<string, { x: number; y: number }>;
const edgeLabel = (value: string) => ({ supports: '지지한다', extends: '확장한다', instantiates: '구체화한다', refines: '다듬는다', contradicts: '반박한다', related: '관련된다' }[value] ?? value);
const typeLabel = (value: string) => ({ semantic: '의미', procedural: '절차', reflective: '성찰', episodic: '경험' }[value] ?? value);
---

<BaseLayout
  title="기억 관계 지도 · beyondwin"
  description="공개 기억 사이의 직접 관계를 정적인 연구 도표로 살펴봅니다."
  pageClass="literary-page literary-memory literary-memory-map"
  headerVariant="literary"
>
  <div class="memory-map-sheet shell" data-memory-map data-memory-fallback={selectedId ?? ''}>
    <aside class="memory-map-rail">
      <h1>기억</h1>
      <label class="memory-search">
        <span class="sr-only">기억 검색</span>
        <input type="search" placeholder="문장, 주제, 출처 검색" data-memory-search />
        <i aria-hidden="true"></i>
      </label>
      <details class="memory-filters">
        <summary>주제 · 근거 필터</summary>
        <div>
          {memory.topics.map((topic) => (
            <label><input type="checkbox" value={topic.label} data-memory-filter="topic" /> {topic.label}</label>
          ))}
          {Array.from(new Set(thoughts.map((thought) => thought.memoryType))).map((kind) => (
            <label><input type="checkbox" value={kind} data-memory-filter="type" /> {typeLabel(kind)}</label>
          ))}
        </div>
      </details>
      <ol class="memory-map-list">
        {thoughts.map((thought, index) => (
          <li class:list={{ 'is-selected': prefixedThoughtId(thought.slug) === selectedId }} data-memory-item data-memory-id={prefixedThoughtId(thought.slug)} data-memory-search-text={`${thought.claimKo} ${thought.claimEn} ${thought.topics.join(' ')}`.toLocaleLowerCase()} data-memory-topics={thought.topics.join(' ')} data-memory-type={thought.memoryType}>
            <a href={`#relation-${thought.slug}`} data-memory-select={prefixedThoughtId(thought.slug)}><span>{String(index + 1).padStart(2, '0')}</span><strong>{thought.claimKo}</strong></a>
          </li>
        ))}
      </ol>
      <a class="memory-view-switch" href="/memory/">문장으로 보기 <span aria-hidden="true">→</span></a>
    </aside>

    <main class="memory-map-field">
      <header><h2>관계 지도</h2><p>움직임 없이 관계 강조</p></header>
      <div class="memory-static-map" aria-label="공개 기억 직접 관계 지도">
        <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <marker id="memory-map-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="3.5" markerHeight="3.5" orient="auto-start-reverse">
              <path d="M 0 0 L 8 4 L 0 8 z"></path>
            </marker>
          </defs>
          {directEdges.map((edge) => {
            const from = positionsById[edge.from] ?? { x: 50, y: 50 };
            const to = positionsById[edge.to] ?? { x: 50, y: 50 };
            return <line x1={from.x} y1={from.y} x2={to.x} y2={to.y} marker-end="url(#memory-map-arrow)" data-memory-edge data-from={edge.from} data-to={edge.to} />;
          })}
        </svg>
        {thoughtNodes.map((node) => {
          const index = thoughts.findIndex((thought) => prefixedThoughtId(thought.slug) === node.id);
          return (
            <a
              id={`map-${node.id.replace('thought:', '')}`}
              href={`#relation-${node.id.replace('thought:', '')}`}
              class:list={['memory-map-node', { 'is-selected': node.id === selectedId }]}
              style={`--x:${node.position.x};--y:${node.position.y}`}
              data-memory-node={node.id}
              data-memory-select={node.id}
            ><span>{String(index + 1).padStart(2, '0')}</span><strong>{node.label}</strong></a>
          );
        })}
      </div>
    </main>

    <aside class="memory-relation-stack" aria-label="선택한 관계">
      {thoughts.map((thought) => {
        const id = prefixedThoughtId(thought.slug);
        const detail = payload.details[id];
        return (
          <section id={`relation-${thought.slug}`} class:list={['memory-relation-panel', { 'is-default': id === selectedId }]} data-memory-detail={id}>
            <div class="memory-sheet-handle" aria-hidden="true"></div>
            <p>선택한 관계</p>
            {detail.directConnections?.length ? detail.directConnections.map((connection) => {
              const connectedIndex = thoughts.findIndex((item) => prefixedThoughtId(item.slug) === connection.thought.id);
              return (
                <article>
                  <h2>{edgeLabel(connection.type)} <span aria-hidden="true">→</span></h2>
                  <p><span>{String(connectedIndex + 1).padStart(2, '0')}</span>{connection.thought.title}</p>
                </article>
              );
            }) : <p class="memory-quiet">직접 연결된 공개 문장이 없습니다.</p>}
            <a class="memory-view-switch" href={`/memory/#memory-detail-${thought.slug}`}>문장 상세로 보기 <span aria-hidden="true">→</span></a>
          </section>
        );
      })}
    </aside>
  </div>

  <LiteraryFooter />
  <script is:inline src="/scripts/memory-workbench.js" defer></script>
</BaseLayout>
