---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { loadHomePresentation, selectHomeThought } from '../lib/homeData';
import { loadPublicMemoryData } from '../lib/memoryData';

const {
  featuredArticle,
  featuredReview,
  moreArticles,
  moreBooks,
} = await loadHomePresentation();
const featuredThought = selectHomeThought(loadPublicMemoryData().thoughts);
---

<BaseLayout description="글과 책, 그리고 남는 문장.">
  <div class="press-sheet home-sheet">
    <article class="home-lead">
      {featuredArticle && (
        <a href={featuredArticle.href} class="home-writing">
          <h1>{featuredArticle.title}</h1>
          <p>{featuredArticle.description}</p>
        </a>
      )}
      {featuredReview && (
        <a href={featuredReview.href} class="home-book">
          {featuredReview.media ? (
            <Image
              class="home-book__plate"
              src={featuredReview.media.asset}
              alt={featuredReview.media.item.alt}
              width={180}
              height={270}
              loading="eager"
            />
          ) : (
            <span class="home-book__plate home-book__plate--set">
              <b>{featuredReview.title}</b>
              {featuredReview.authors.length > 0 && <em>{featuredReview.authors.join(' · ')}</em>}
            </span>
          )}
        </a>
      )}
    </article>
    {featuredThought && (
      <aside class="home-proof">
        <a href={featuredThought.href}>{featuredThought.claimKo}</a>
      </aside>
    )}
    {moreArticles.length > 0 && (
      <section class="home-more-writing" aria-label="글">
        {moreArticles.map((article) => (
          <a href={article.href}>{article.title}</a>
        ))}
      </section>
    )}
    {moreBooks.length > 0 && (
      <section class="home-more-books" aria-label="책">
        {moreBooks.map((book) => (
          <a href={book.href} class="home-book">
            {book.media ? (
              <Image
                class="home-book__plate"
                src={book.media.asset}
                alt={book.media.item.alt}
                width={96}
                height={144}
                loading="lazy"
              />
            ) : (
              <span class="home-book__plate home-book__plate--set">
                <b>{book.title}</b>
                {book.authors.length > 0 && <em>{book.authors.join(' · ')}</em>}
              </span>
            )}
          </a>
        ))}
      </section>
    )}
  </div>
  <SiteFooter />
</BaseLayout>
