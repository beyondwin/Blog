---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicScene from '../components/PublicScene.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { loadJudgmentScene } from '../lib/homeData';
import '../styles/storyworld.css';

const { scene, issues } = await loadJudgmentScene();
for (const issue of issues) console.warn('[public-scene] ' + issue.objectId + ': ' + issue.message);

const storyworldDesignContract = `THESIS: One curated daylight scene makes the writing tangible; it refuses hero, card-grid, and dashboard arrangements.
OWN-WORLD: Flat mineral gray, optical white, rich ink, cobalt selection, precise sans, bounded image apertures, and text-only objects.
STORY: The visitor sees one judgment, understands its article, book, image, and excerpt relations, focuses an object, then reads or returns.
FIRST VIEWPORT: The cobalt desk dominates center-right; the article title occupies left negative space; judgment, black-swan, excerpt, and table stay at the edges. 읽기 leads focus and 전체 보기 restores the scene.
FORM: Staged Aperture, the approved first-ranked composition; seed approved-staged-aperture-2026-08-22.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance`;
---

<BaseLayout
  title="판단 · beyondwin"
  description="AI 시대에 무엇을 믿을지 판단하기 위해 읽고 연결한 글, 책, 문장."
  pageClass="storyworld-page"
  themeColor="#F2F4F7"
  designContract={storyworldDesignContract}
>
  <PublicScene scene={scene} />
  <SiteFooter />
</BaseLayout>
