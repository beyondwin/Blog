---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { loadPublicMemoryData, sortMemoryReading } from '../lib/memory';
import { memoryThoughtHref } from '../lib/siteChrome';

const requestedThought = Astro.url.searchParams.get('thought');
const requestedThoughtHref = requestedThought ? memoryThoughtHref(requestedThought) : null;
if (requestedThoughtHref) {
  return Astro.redirect(requestedThoughtHref);
}

const entries = sortMemoryReading(loadPublicMemoryData().thoughts);
---

<BaseLayout title="문장 · beyondwin" description="글로 쓰고 난 뒤에도 남는 문장만 여기에 둡니다.">
  <script is:inline>
    const thought = new URLSearchParams(location.search).get('thought');
    const fromHash = location.hash.replace(/^#(?:map|relation|memory-detail)-/, '');
    const slug = thought || fromHash;
    if (slug && /^[a-z0-9-]+$/i.test(slug)) {
      location.replace(`/memory/${slug}/`);
    }
  </script>
  <div class="press-sheet memory-sheet">
    <h1 class="visually-hidden">문장</h1>
    <p class="memory-opening">글로 쓰고 난 뒤에도 남는 문장만 여기에 둡니다.</p>
    {entries.length === 0 ? (
      <p>아직 공개한 문장이 없습니다. <a href="/articles/">글로 돌아갑니다</a>.</p>
    ) : (
      <div class="memory-reading">
        {entries.map((entry, index) => (
          <>
            {index > 0 && entries[index - 1].cluster !== entry.cluster && (
              <p class="memory-break" aria-hidden="true"></p>
            )}
            <a class="memory-sentence" href={entry.href}>{entry.claimKo}</a>
          </>
        ))}
      </div>
    )}
  </div>
  <SiteFooter />
</BaseLayout>
