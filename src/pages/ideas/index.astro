---
import ContentCard from '../../components/ContentCard.astro';
import EmptyLane from '../../components/EmptyLane.astro';
import LiteraryFooter from '../../components/LiteraryFooter.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { collectionMeta, getContentByCollection } from '../../lib/content';
import '../../styles/empty-literary.css';

const entries = await getContentByCollection('ideas');
const meta = collectionMeta.ideas;
---

<BaseLayout title="생각 노트 · beyondwin" description={meta.description} pageClass="literary-page literary-empty" headerVariant="literary">
  <div class="shell empty-sheet">
  <section>
    {entries.length > 0 ? (
      <div class="content-grid">
        {entries.map((entry) => <ContentCard entry={entry} />)}
      </div>
    ) : (
      <EmptyLane lane="ideas" />
    )}
  </section>
  </div>
  <LiteraryFooter />
</BaseLayout>
