---
import EmptyLane from '../../components/EmptyLane.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getContentByCollection } from '../../lib/content';
import { getEmptyLaneCopy } from '../../lib/indexPresentation';

const entries = await getContentByCollection('ideas');
const copy = getEmptyLaneCopy('ideas');
---

<BaseLayout title="beyondwin" description={copy.fact}>
  <div class="press-sheet empty-sheet">
    {entries.length > 0 ? (
      <ol class="empty-lane__stock">
        {entries.map((entry) => (
          <li><a href={`/ideas/${entry.id}/`}>{entry.data.title}</a></li>
        ))}
      </ol>
    ) : (
      <EmptyLane lane="ideas" />
    )}
  </div>
  <SiteFooter />
</BaseLayout>
