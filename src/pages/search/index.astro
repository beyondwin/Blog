---
import { Image } from 'astro:assets';
import SiteFooter from '../../components/SiteFooter.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadSearchRecords } from '../../lib/searchData';
import {
  buildSearchInventory,
  buildSearchMatches,
  searchGroupLabel,
  type SearchKind,
} from '../../lib/searchPresentation';

const inventory = buildSearchInventory(await loadSearchRecords());
const query = Astro.url.searchParams.get('q')?.trim() ?? '';
const emptyQueryKinds = ['writing', 'book', 'sentence'] as const satisfies readonly SearchKind[];
const matches = query ? buildSearchMatches(inventory, query) : [];
const visibleIds = query ? new Set(matches.map((match) => match.record.id)) : null;
const matchReasonById = new Map(matches.map((match) => [match.record.id, match.matchReason]));
const groups = emptyQueryKinds
  .map((kind) => ({
    kind,
    label: searchGroupLabel[kind],
    records: inventory.filter((record) => record.kind === kind),
  }))
  .filter((group) => group.records.length > 0);
const topicRecords = inventory.filter((record) => record.kind === 'topic');
const visibleTopicIds = new Set(
  query ? matches.filter((match) => match.record.kind === 'topic').map((match) => match.record.id) : [],
);
const visibleTotal = visibleIds ? visibleIds.size : inventory.filter((record) => record.kind !== 'topic').length;
---

<BaseLayout title="찾기 · beyondwin" description="글, 책, 문장을 찾습니다.">
  <div class="press-sheet search-sheet">
    <h1 data-search-query-heading>{query || '찾기'}</h1>
    <form class="search-box" action="/search/" method="get" role="search">
      <input
        name="q"
        type="search"
        value={query}
        autocomplete="off"
        aria-label="찾기"
        data-search-input
      />
      <button type="button" aria-label="검색어 지우기" data-search-clear>×</button>
    </form>
    <p class="search-quiet" data-search-summary>
      {query ? `“${query}”` : '글 · 책 · 문장'}
    </p>

    <div class="search-groups" data-search-groups>
      {groups.map((group) => {
        const visibleCount = visibleIds
          ? group.records.filter((record) => visibleIds.has(record.id)).length
          : group.records.length;
        return (
          <section
            class:list={['search-group', `search-group--${group.kind}`]}
            data-search-group={group.kind}
            hidden={visibleCount === 0}
          >
            <h2>{group.label}</h2>
            {group.records.map((record) => (
              <a
                href={record.href}
                class="search-result"
                data-search-record
                data-search-id={record.id}
                data-search-kind={record.kind}
                data-search-title={record.title.toLocaleLowerCase('ko')}
                data-search-description={record.description.toLocaleLowerCase('ko')}
                data-search-topics={record.topics.join('\n').toLocaleLowerCase('ko')}
                hidden={visibleIds !== null && !visibleIds.has(record.id)}
              >
                {record.kind === 'book' && (
                  record.media ? (
                    <Image
                      class="book-cover book-cover--small"
                      src={record.media.asset}
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <span class="book-cover book-cover--small book-cover--set" aria-hidden="true">
                      <b>{record.title}</b>
                    </span>
                  )
                )}
                <span class="search-result__copy">
                  <h3>{record.title}</h3>
                  <p data-match-reason hidden={!query}>
                    {matchReasonById.get(record.id) ?? ''}
                  </p>
                </span>
              </a>
            ))}
          </section>
        );
      })}
      {topicRecords.length > 0 && (
        <section
          class="search-group search-group--topic"
          data-search-group="topic"
          hidden={visibleTopicIds.size === 0}
        >
          <h2>{searchGroupLabel.topic}</h2>
          {topicRecords.map((record) => (
            <a
              href={record.href}
              class="search-result"
              data-search-record
              data-search-id={record.id}
              data-search-kind={record.kind}
              data-search-title={record.title.toLocaleLowerCase('ko')}
              data-search-description={record.description.toLocaleLowerCase('ko')}
              data-search-topics={record.topics.join('\n').toLocaleLowerCase('ko')}
              hidden={!visibleTopicIds.has(record.id)}
            >
              <span class="search-result__copy">
                <h3>{record.title}</h3>
                <p data-match-reason hidden={!query}>
                  {matchReasonById.get(record.id) ?? ''}
                </p>
              </span>
            </a>
          ))}
        </section>
      )}
      <p class="search-empty" data-search-empty hidden={visibleTotal !== 0}>
        일치하는 글이 없습니다.
      </p>
    </div>
  </div>
  <SiteFooter />

  <script>
    const input = document.querySelector('[data-search-input]');
    const clear = document.querySelector('[data-search-clear]');
    const heading = document.querySelector('[data-search-query-heading]');
    const summary = document.querySelector('[data-search-summary]');
    const empty = document.querySelector('[data-search-empty]');
    const records = Array.from(document.querySelectorAll('[data-search-record]'));
    const groups = Array.from(document.querySelectorAll('[data-search-group]'));

    import { matchLiterarySearchFields } from '../../lib/searchPresentation';

    const fieldLabel: Record<string, string> = {
      title: '제목',
      description: '설명',
      topic: '주제',
    };

    function reasonFor(kind: string | undefined, field: string, rawQuery: string): string {
      if (!rawQuery) return '';
      if (field === 'title' && kind === 'book') return `책 제목에서 “${rawQuery}” 일치`;
      if (field === 'title' && kind === 'sentence') return `문장에서 “${rawQuery}” 일치`;
      return `${fieldLabel[field] ?? field}에서 “${rawQuery}” 일치`;
    }

    function updateSearch() {
      if (!(input instanceof HTMLInputElement)) return;
      const rawQuery = input.value.trim();
      const counts: Record<string, number> = { writing: 0, book: 0, sentence: 0, topic: 0 };

      records.forEach((node) => {
        if (!(node instanceof HTMLElement)) return;
        const kind = node.dataset.searchKind;
        if (!rawQuery) {
          node.hidden = kind === 'topic';
          const reason = node.querySelector('[data-match-reason]');
          if (reason instanceof HTMLElement) reason.hidden = true;
          if (kind && kind !== 'topic' && kind in counts) counts[kind] += 1;
          return;
        }
        const field = matchLiterarySearchFields({
          title: node.dataset.searchTitle ?? '',
          description: node.dataset.searchDescription ?? '',
          topics: node.dataset.searchTopics?.split('\n') ?? [],
        }, rawQuery);
        node.hidden = field === null;
        const reason = node.querySelector('[data-match-reason]');
        if (reason instanceof HTMLElement) {
          reason.hidden = field === null;
          if (field) reason.textContent = reasonFor(kind, field, rawQuery);
        }
        if (field !== null && kind && kind in counts) counts[kind] += 1;
      });

      groups.forEach((group) => {
        if (!(group instanceof HTMLElement)) return;
        const kind = group.dataset.searchGroup;
        group.hidden = !kind || counts[kind] === 0;
      });

      const total = Object.values(counts).reduce((sum, count) => sum + count, 0);
      if (heading) heading.textContent = rawQuery || '찾기';
      if (summary) summary.textContent = rawQuery ? `“${rawQuery}”` : '글 · 책 · 문장';
      if (empty instanceof HTMLElement) empty.hidden = total !== 0;
      history.replaceState(null, '', rawQuery ? `/search/?q=${encodeURIComponent(rawQuery)}` : '/search/');
    }

    if (input instanceof HTMLInputElement) {
      const requestedQuery = new URLSearchParams(location.search).get('q');
      if (requestedQuery !== null) input.value = requestedQuery;
      updateSearch();
    }
    input?.addEventListener('input', updateSearch);
    clear?.addEventListener('click', () => {
      if (!(input instanceof HTMLInputElement)) return;
      input.value = '';
      updateSearch();
      input.focus();
    });
  </script>
</BaseLayout>
