---
import { Image } from 'astro:assets';
import LiteraryFooter from '../../components/LiteraryFooter.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadLiterarySearchRecords } from '../../lib/searchData';
import { summarizeSearchMatches } from '../../lib/searchPresentation';
import '../../styles/search-literary.css';

const records = await loadLiterarySearchRecords();
const groupOrder = ['technical', 'reading', 'memory', 'topic'] as const;
const groupLabels = {
  technical: '기술 문서',
  reading: '책',
  memory: '기억',
  topic: '주제',
};
const groupedRecords = Object.fromEntries(groupOrder.map((kind) => [
  kind,
  records.filter((record) => record.kind === kind),
])) as Record<(typeof groupOrder)[number], typeof records>;
const indexSummary = summarizeSearchMatches(records.map((record) => ({
  record,
  matchedField: 'title' as const,
  matchReason: '',
})));
---

<BaseLayout
  title="검색 · beyondwin"
  description="제목, 설명, 책, 주제와 공개 기억을 함께 찾는 문학 색인."
  pageClass="literary-page literary-search"
  headerVariant="literary"
>
  <div class="shell search-sheet">
    <aside class="search-intro">
      <p>공개 색인</p>
      <h1 data-search-query-heading>검색</h1>
      <span class="literary-registration" aria-hidden="true"></span>
      <p class="search-intro__copy">JavaScript 없이도 모든 공개 기록을 읽을 수 있고,<br />검색어를 입력하면 즉시 결과를 좁힙니다.</p>
      <p class="search-summary" data-search-summary>
        공개 색인 {indexSummary.total}건 · 기술 문서 {indexSummary.technical} · 기억 {indexSummary.memory} · 주제 {indexSummary.topic}
      </p>
    </aside>

    <section class="search-results" aria-labelledby="search-results-title">
      <h2 id="search-results-title" class="visually-hidden">검색 결과</h2>
      <form class="search-box" action="/search/" role="search" data-literary-search-form>
        <span aria-hidden="true"></span>
        <input
          name="q"
          autocomplete="off"
          aria-label="전체 기록 검색"
          data-literary-search-input
        />
        <button type="button" aria-label="검색어 지우기" data-search-clear>×</button>
      </form>

      <div class="search-groups" data-search-groups>
        {groupOrder.map((kind) => (
          <section
            class:list={['search-group', `search-group--${kind}`]}
            data-search-group={kind}
          >
            <header><h3>{groupLabels[kind]}</h3><span data-search-group-count>{indexSummary[kind]}</span></header>
            <div>
              {groupedRecords[kind].map((record) => {
                return (
                  <a
                    href={record.href}
                    class="search-result"
                    data-search-record
                    data-search-id={record.id}
                    data-search-kind={record.kind}
                    data-search-title={record.title.toLocaleLowerCase('ko')}
                    data-search-description={record.description.toLocaleLowerCase('ko')}
                    data-search-topics={record.topics.join('\n').toLocaleLowerCase('ko')}
                  >
                    {record.kind === 'reading' && (
                      <span class="search-result__cover" aria-hidden="true">
                        {record.media ? (
                          <Image src={record.media.asset} alt="" loading="lazy" decoding="async" />
                        ) : (
                          <b>표지<br />확인 중</b>
                        )}
                      </span>
                    )}
                    <span class="search-result__copy">
                      <h4>{record.title}</h4>
                      <p><span data-match-prefix>색인</span>: <span data-match-reason>공개 기록</span>{record.date && <> · {record.date}</>}</p>
                    </span>
                  </a>
                );
              })}
            </div>
          </section>
        ))}
        <p class="search-no-result" data-search-no-result hidden>
          <span aria-hidden="true">—</span> 일치하는 기록이 없습니다. 다른 문장으로 찾아보세요.
        </p>
      </div>
    </section>

    <aside class="search-index" aria-label="검색 결과 색인">
      <h2>일치 색인</h2>
      {groupOrder.map((kind) => (
        <p class={`search-index__${kind}`}><span>{groupLabels[kind]}</span><b data-search-index-count={kind}>{indexSummary[kind]}</b></p>
      ))}
      <p class="search-index__note">검색어와 일치한 위치를 결과마다 표시합니다.</p>
    </aside>
  </div>
  <LiteraryFooter />

  <script>
    const input = document.querySelector('[data-literary-search-input]');
    const clear = document.querySelector('[data-search-clear]');
    const queryHeading = document.querySelector('[data-search-query-heading]');
    const summaryNode = document.querySelector('[data-search-summary]');
    const noResult = document.querySelector('[data-search-no-result]');
    const records = Array.from(document.querySelectorAll('[data-search-record]'));
    const groups = Array.from(document.querySelectorAll('[data-search-group]'));

    import { matchLiterarySearchFields } from '../../lib/searchPresentation';

    const fieldLabel: Record<string, string> = { title: '제목', description: '설명', topic: '주제' };
    function updateSearch() {
      if (!(input instanceof HTMLInputElement)) return;
      const rawQuery = input.value.trim();
      const counts: Record<string, number> = { technical: 0, reading: 0, memory: 0, topic: 0 };

      records.forEach((node) => {
        if (!(node instanceof HTMLElement)) return;
        const field = rawQuery ? matchLiterarySearchFields({
          title: node.dataset.searchTitle ?? '',
          description: node.dataset.searchDescription ?? '',
          topics: node.dataset.searchTopics?.split('\n') ?? [],
        }, rawQuery) : 'title';
        node.hidden = field === null;
        if (field !== null) {
          const kind = node.dataset.searchKind;
          if (kind && kind in counts) counts[kind] = (counts[kind] ?? 0) + 1;
          const reason = node.querySelector('[data-match-reason]');
          const prefix = node.querySelector('[data-match-prefix]');
          if (reason) {
            const fieldName = !rawQuery
              ? '공개 기록'
              : field === 'title' && kind === 'reading'
              ? '책 제목'
              : field === 'title' && kind === 'memory'
                ? '기억 문장'
                : fieldLabel[field];
            reason.textContent = rawQuery ? `${fieldName}에서 “${rawQuery}” 일치` : fieldName;
          }
          if (prefix) prefix.textContent = rawQuery ? '이유' : '색인';
        }
      });

      groups.forEach((group) => {
        if (!(group instanceof HTMLElement)) return;
        const kind = group.dataset.searchGroup;
        const count = kind && kind in counts ? counts[kind] : 0;
        group.hidden = count === 0;
        const countNode = group.querySelector('[data-search-group-count]');
        if (countNode) countNode.textContent = String(count);
      });
      Object.entries(counts).forEach(([kind, count]) => {
        const node = document.querySelector(`[data-search-index-count="${kind}"]`);
        if (node) node.textContent = String(count);
      });
      const total = Object.values(counts).reduce((sum, count) => sum + count, 0);
      if (queryHeading) queryHeading.textContent = rawQuery || '검색';
      if (summaryNode) summaryNode.textContent = rawQuery
        ? `총 ${total}건 · 기술 문서 ${counts.technical} · 기억 ${counts.memory} · 주제 ${counts.topic}`
        : `공개 색인 ${total}건 · 기술 문서 ${counts.technical} · 기억 ${counts.memory} · 주제 ${counts.topic}`;
      if (noResult instanceof HTMLElement) noResult.hidden = total !== 0;
      history.replaceState(null, '', rawQuery ? `/search/?q=${encodeURIComponent(rawQuery)}` : '/search/');
    }

    if (input instanceof HTMLInputElement) {
      const requestedQuery = new URLSearchParams(location.search).get('q');
      if (requestedQuery !== null) input.value = requestedQuery;
      updateSearch();
    }
    input?.addEventListener('input', updateSearch);
    clear?.addEventListener('click', () => {
      if (!(input instanceof HTMLInputElement)) return;
      input.value = '';
      updateSearch();
      input.focus();
    });
  </script>
</BaseLayout>
